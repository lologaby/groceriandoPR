# Production Environment Variables for Railway/Render
# Copia estos valores a Railway → Variables

# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://groceriando.vercel.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/groceriando?retryWrites=true&w=majority

# Upstash Redis
REDIS_URL=redis://default:token@xxxxx.upstash.io:6379
# O configuración individual:
REDIS_HOST=xxxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=token

# Scraping (opcional)
SCRAPE_ON_START=false
WARM_CACHE_ON_START=false

# Puppeteer (para Railway)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Notion (opcional - usuarios configuran en UI)
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
