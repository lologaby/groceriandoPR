# Puerto del servidor
PORT=3001

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/groceriando
# O si usas MongoDB Atlas:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/groceriando

# Redis Configuration
REDIS_URL=redis://localhost:6379
# O si usas Redis con contraseña:
# REDIS_URL=redis://:password@localhost:6379
# O si usas Upstash Redis:
# REDIS_URL=rediss://default:password@your-redis.upstash.io:6379

# Redis individual config (si no usas REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache warming al iniciar servidor
WARM_CACHE_ON_START=false

# Scraping completo al iniciar (solo para primera vez o testing)
SCRAPE_ON_START=false

# Notion API (si aplica)
NOTION_API_KEY=your_notion_api_key_here
