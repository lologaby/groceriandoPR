### Error Handling
```typescript
// SIEMPRE manejar errores explícitamente
// ❌ MAL
const products = await searchProducts(query);

// ✅ BIEN
try {
  const products = await searchProducts(query);
  return { data: products, error: null };
} catch (error) {
  console.error('Error searching products:', error);
  return { 
    data: null, 
    error: error instanceof Error ? error.message : 'Unknown error' 
  };
}

// Para servicios, usar Result type
type Result<T> = 
  | { success: true; data: T }
  | { success: false; error: string };

async function searchProducts(query: string): Promise<Result<Product[]>> {
  try {
    const data = await fetch(`/api/products?q=${query}`);
    return { success: true, data };
  } catch (error) {
    return { 
      success: false, 
      error: error instanceof Error ? error.message : 'Unknown error' 
    };
  }
}
```

### React Components
```typescript
// SIEMPRE usar functional components con TypeScript
// ❌ MAL
function ProductCard(props) {
  return <div>{props.name}</div>;
}

// ✅ BIEN
interface ProductCardProps {
  product: Product;
  onSelect: (product: Product) => void;
  showPrice?: boolean;
}

const ProductCard: React.FC<ProductCardProps> = ({ 
  product, 
  onSelect,
  showPrice = true 
}) => {
  return (
    <div onClick={() => onSelect(product)}>
      <h3>{product.name}</h3>
      {showPrice && <p>${product.price}</p>}
    </div>
  );
};

export default ProductCard;
```

### API Design
```typescript
// RESTful endpoints con tipos claros

// GET /api/products/search
interface ProductSearchRequest {
  q: string;
  category?: string;
  limit?: number;
}

interface ProductSearchResponse {
  products: Product[];
  total: number;
  cached: boolean;
}

// POST /api/products/check-stores
interface CheckStoresRequest {
  productName: string;
  upc: string;
  userLocation: string;
  showAllStores?: boolean; // true = mostrar todo PR, false = solo cerca
}

interface CheckStoresResponse {
  results: StoreResult[];
  recommendations: Recommendation[];
  alternatives: Alternative[];
  bestDeal: {
    store: string;
    price: number;
    unitPrice: number;
  };
}

// POST /api/notion/add-item
interface AddToNotionRequest {
  notionApiKey: string;
  databaseId: string;
  productData: {
    productName: string;
    brand: string;
    upc: string;
    quantity: number;
    selectedStore: string;
    selectedLocation: string;
    price: number;
    allPrices: Record<string, number | null>;
    alternatives: Alternative[];
    recommendations: string[];
  };
}
```

### Caching Strategy
```typescript
// Usar Redis con TTLs apropiados

// Product database search: 24 horas (productos no cambian)
await redis.setex(`product:search:${query}`, 86400, JSON.stringify(products));

// Store scraping: 2 horas (precios pueden cambiar)
await redis.setex(`store:${upc}:${store}:${location}`, 7200, JSON.stringify(result));

// User preferences: 7 días
await redis.setex(`user:${userId}:prefs`, 604800, JSON.stringify(prefs));

// Historical prices: No expiration (usar database)
await db.prices.insert({ product, store, price, date: new Date() });
```

### Web Scraping Best Practices
```typescript
// Base Scraper que todos heredan
abstract class BaseScraper {
  protected browser?: Browser;
  protected maxRetries = 3;
  protected timeout = 15000;
  
  abstract searchProduct(
    productName: string, 
    location?: string
  ): Promise<StoreResult[]>;
  
  protected async initBrowser(): Promise<void> {
    this.browser = await puppeteer.launch({
      headless: true,
      args: ['--no-sandbox', '--disable-setuid-sandbox']
    });
  }
  
  protected async closeBrowser(): Promise<void> {
    if (this.browser) {
      await this.browser.close();
    }
  }
  
  protected parsePrice(priceText: string): number {
    // Limpiar texto: "$8.99" -> 8.99
    const cleaned = priceText.replace(/[^0-9.]/g, '');
    const price = parseFloat(cleaned);
    return isNaN(price) ? 0 : price;
  }
  
  protected async retryOnFail<T>(
    fn: () => Promise<T>,
    retries = this.maxRetries
  ): Promise<T> {
    try {
      return await fn();
    } catch (error) {
      if (retries > 0) {
        await this.delay(1000);
        return this.retryOnFail(fn, retries - 1);
      }
      throw error;
    }
  }
  
  protected delay(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
}

// Ejemplo de implementación
class SuperMaxScraper extends BaseScraper {
  async searchProduct(productName: string): Promise<StoreResult[]> {
    await this.initBrowser();
    
    try {
      const page = await this.browser!.newPage();
      
      // User agent real
      await page.setUserAgent(
        'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
      );
      
      // Ir al sitio
      await page.goto('https://www.supermaxonline.com', {
        waitUntil: 'networkidle2',
        timeout: this.timeout
      });
      
      // Buscar producto
      await page.type('.search-input', productName);
      await page.click('.search-button');
      
      // Esperar resultados
      await page.waitForSelector('.product-item', { 
        timeout: this.timeout 
      });
      
      // Extraer data
      const products = await page.evaluate(() => {
        // ... código de extracción
      });
      
      return this.normalizeResults(products);
      
    } finally {
      await this.closeBrowser();
    }
  }
  
  private normalizeResults(raw: any[]): StoreResult[] {
    return raw.map(p => ({
      storeName: 'SuperMax',
      productName: p.name,
      price: this.parsePrice(p.price),
      available: p.available,
      url: p.url,
      location: 'Multiple locations',
      lastUpdated: new Date(),
      status: 'found'
    }));
  }
}
```

### Smart Recommendations Service
```typescript
// Servicio que genera recomendaciones inteligentes
class SmartRecommendationService {
  async getRecommendations(
    product: Product,
    storeResults: StoreResult[],
    userLocation: string
  ): Promise<Recommendation[]> {
    const recommendations: Recommendation[] = [];
    
    // 1. Mejor precio unitario
    const unitPrices = this.calculateUnitPrices(storeResults);
    const bestUnitPrice = this.findBestUnitPrice(unitPrices);
    recommendations.push({
      type: 'best_unit_price',
      message: `Mejor precio por unidad: ${bestUnitPrice.store} ($${bestUnitPrice.pricePerUnit}/oz)`,
      savings: this.calculateSavings(bestUnitPrice, unitPrices)
    });
    
    // 2. Mejor precio para 1 unidad
    const bestSinglePrice = this.findBestSinglePrice(storeResults);
    if (bestSinglePrice) {
      recommendations.push({
        type: 'best_single_price',
        message: `Para 1 unidad: ${bestSinglePrice.store} ($${bestSinglePrice.price})`,
        store: bestSinglePrice.store
      });
    }
    
    // 3. Alternativas más baratas
    const alternatives = await this.findAlternatives(product, storeResults);
    if (alternatives.length > 0) {
      recommendations.push({
        type: 'alternatives',
        message: 'Alternativas más baratas disponibles',
        alternatives: alternatives.slice(0, 3)
      });
    }
    
    // 4. Tiendas cerca del usuario
    const nearbyStores = this.filterByLocation(storeResults, userLocation);
    if (nearbyStores.length > 0) {
      recommendations.push({
        type: 'nearby',
        message: `${nearbyStores.length} opciones cerca de ${userLocation}`,
        stores: nearbyStores
      });
    }
    
    // 5. Ofertas especiales
    const onSale = storeResults.filter(r => r.onSale);
    if (onSale.length > 0) {
      recommendations.push({
        type: 'sale',
        message: `🔥 En oferta en ${onSale.length} tiendas`,
        stores: onSale
      });
    }
    
    return recommendations;
  }
  
  private calculateUnitPrices(results: StoreResult[]): UnitPrice[] {
    return results.map(result => ({
      store: result.storeName,
      price: result.price,
      size: this.extractSize(result.productName), // ej: "8oz"
      pricePerUnit: this.calculatePricePerOz(result.price, result.productName)
    }));
  }
  
  private async findAlternatives(
    product: Product,
    storeResults: StoreResult[]
  ): Promise<Alternative[]> {
    // Buscar productos similares más baratos
    const category = product.category;
    const maxPrice = Math.min(...storeResults.map(r => r.price));
    
    const alternatives = await db.products.find({
      category,
      averagePrice: { $lt: maxPrice },
      brand: { $ne: product.brand } // Marca diferente
    }).limit(5);
    
    return alternatives;
  }
}
```

### UI/UX Guidelines

```typescript
// Loading states SIEMPRE visibles
const StoreComparison = ({ product }) => {
  const { data, isLoading, error } = useStoreComparison(product);
  
  if (isLoading) {
    return (
      <div className="space-y-4">
        <div className="flex items-center gap-3">
          <Spinner />
          <p>Buscando en supermercados de Puerto Rico...</p>
        </div>
        
        {/* Mostrar progreso por tienda */}
        <div className="space-y-2">
          <StoreLoadingIndicator store="SuperMax" status="checking" />
          <StoreLoadingIndicator store="Econo" status="found" />
          <StoreLoadingIndicator store="Walmart" status="checking" />
          <StoreLoadingIndicator store="Costco" status="pending" />
        </div>
      </div>
    );
  }
  
  // ... resto del componente
};

// Errores con fallback útil
if (error) {
  return (
    <ErrorState
      title="No pudimos buscar en algunos supermercados"
      message="Pero aquí están los resultados que encontramos:"
      action={<Button onClick={retry}>Reintentar</Button>}
    >
      {/* Mostrar resultados parciales aunque haya error */}
      {partialResults.map(result => (
        <StoreCard key={result.store} result={result} />
      ))}
    </ErrorState>
  );
}
